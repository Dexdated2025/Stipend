# Copy this file to .env.local for local dev, and add the same keys in your host's
# environment variables (Vercel / Netlify / Cloudflare) for production.
# All VITE_ variables are bundled into the browser. Never put secret keys here.

# Supabase project URL: Supabase dashboard > Project Settings > API (or Data API) > Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase public key: the "anon" key or the "publishable" key (sb_publishable_...).
# NOT the service_role / secret key.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: shows a Contact link in the footer
VITE_CONTACT_EMAIL=

# Optional: your own Base Sepolia RPC (Alchemy, QuickNode, Coinbase CDP...).
# Defaults to the public https://sepolia.base.org, which is rate limited.
VITE_BASE_SEPOLIA_RPC_URL=
